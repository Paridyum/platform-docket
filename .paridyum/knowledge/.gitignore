.DS_Store
*.swp
*~

# Vendored knowledge snapshots must never appear in the canonical repo (ADR-0001).
# Guards against a sync running in the wrong direction.
.paridyum/

# forge scratch output
.forge/

# --- build output and dependencies -----------------------------------------
# ADR-0025 commits with `git add -A`, which makes this file load-bearing rather than a
# convenience: anything not ignored here is committed automatically, by a hook, with no
# human looking. The secret scan catches credentials; only this catches bulk.
target/
node_modules/
dist/
build/
.next/
coverage/
__pycache__/
*.pyc
.venv/
venv/
*.tsbuildinfo

# --- local environment ------------------------------------------------------
# .env is also matched by repo.no_credential_files_committed, which reads NAMES, and by the
# secret scan, which reads CONTENT. Three independent layers, because a committed credential
# cannot be removed by a later commit.
.env
.env.*
!.env.example

# --- editor and scratch -----------------------------------------------------
.idea/
*.tmp
*.log

# `plan/` is deliberately NOT ignored. STD-0007 slices are ephemeral but they must appear in
# the pull request that implements them — a reviewer reads the slice to know what the PR is
# scoped to. Ephemeral means deleted at merge, not untracked.

# Generated by scripts/test-checks.sh — evidence, not source (STD-0008)
junit.xml
