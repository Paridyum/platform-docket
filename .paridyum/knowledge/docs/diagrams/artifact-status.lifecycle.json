        "id": "main",
        "label": "The ordinary path",
        "focus": [
          "draft",
          "proposed",
          "accepted",
          "locked"
        ],
        "note": "Created accepted, facts checked, locked in a separate commit. ADR-0029 has two errata because that ordering was not followed."
      },
      {
        "id": "locked-exits",
        "label": "Leaving locked",
        "focus": [
          "locked",
          "erratum",
          "superseded"
        ],
        "note": "Two legal changes and only two. An erratum fixes a wrong fact; supersession replaces a wrong decision."
      },
      {
        "id": "never-locked",
        "label": "What may never lock",
        "focus": [
          "deferred",
          "bet_live"
        ],
        "note": "A bet exists to be contradicted by evidence, which is the opposite of what locked means. An RFC may never lock either."
      }
    ],
