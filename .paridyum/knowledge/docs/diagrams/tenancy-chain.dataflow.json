  "cards": [
    {
      "dot": "amber",
      "title": "Fails closed, by construction",
      "items": [
        "Every accessor raises on an unset or empty setting",
        "None returns NULL, ever — a NULL in a predicate is silently permissive",
        "The failure is a stopped transaction, not a wrong row set"
      ]
    },
    {
      "dot": "cyan",
      "title": "Per transaction, not per connection",
      "items": [
        "SET LOCAL, so a pooled connection cannot carry one tenant's context into another's query",
        "The single easiest thing to get structurally wrong"
      ]
    },
    {
      "dot": "emerald",
      "title": "Three table categories, declared",
      "items": [
        "platform-owned — no tenancy column, on an explicit allowlist",
        "tenant-scoped — tenant_id",
        "account-scoped — tenant_id and account_id",
        "Never inferred from the column list"
      ]
    }
  ]
