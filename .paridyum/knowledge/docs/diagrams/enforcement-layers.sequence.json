  "cards": [
    {
      "dot": "amber",
      "title": "Strongest first",
      "items": [
        "Layer 1 denies before the act; every layer below reports after it",
        "It is harness-specific, which is why the others are not redundant",
        "A contributor who declines the plugin gets no layer 1 at all"
      ]
    },
    {
      "dot": "rose",
      "title": "Each layer's escape",
      "items": [
        "Layer 1: work done outside the harness",
        "Layer 2: --no-verify",
        "Layer 3: GitHub Free cannot block a merge",
        "Layer 4: nothing, and it runs least often"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why four",
      "items": [
        "No layer covers the others' gap by being stricter, only by being elsewhere",
        "CI covers commits from any source; layer 1 covers only sessions",
        "The audit is the only one that sees a violation already on main"
      ]
    }
  ]
