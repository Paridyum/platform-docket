          "triage",
          "rfc",
          "review",
          "implement",
          "test",
          "shipping"
        ],
        "note": "Seven triggers make a change significant. It then needs a referenced RFC or ADR before any implementation commit exists."
      },
      {
        "id": "ordinary",
        "label": "Everything else",
        "focus": [
          "triage",
          "implement",
          "test",
          "shipping"
        ],
        "note": "Bug fixes, refactors, tests, docs, bumps inside the locked stack. Treating ordinary work as significant is how a process gets abandoned."
      },
      {
        "id": "gates",
        "label": "What refuses a change",
        "focus": [
          "triage",
          "review",
          "predates",
          "slice"
        ],
        "note": "The points where a change is refused rather than improved — one human, two mechanical."
