  "cards": [
    {
      "dot": "amber",
      "title": "Significance is mechanical",
      "items": [
        "Seven triggers, read off the diff, never self-declared",
        "Public API, HTTP or event contract, dependency outside the locked stack, migration, new crate, helm/terraform/workflows, new service dependency",
        "A judgement-based definition is resolved in favour of skipping it, every time"
      ]
    },
    {
      "dot": "cyan",
      "title": "Design before code, by timestamp",
      "items": [
        "The RFC must exist before the implementation commits",
        "An artifact committed alongside its code carries the authority of a design while having done none of the thinking"
      ]
    },
    {
      "dot": "emerald",
      "title": "Not every RFC becomes an ADR",
      "items": [
        "Stage 2 produces an RFC",
        "It graduates at stage 3 only if it binds future work",
        "Most describe how to build one thing and are finished when it is built"
      ]
    }
  ]
