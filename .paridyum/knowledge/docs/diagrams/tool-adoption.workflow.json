    {
      "dot": "cyan",
      "title": "Retrieval is the expensive half",
      "items": [
        "Rebuilding a capability that already exists costs the original work twice and leaves the first copy rotting",
        "Nothing enforces this step, which is exactly why it comes first"
      ]
    },
    {
      "dot": "amber",
      "title": "The exitability test, every time",
      "items": [
        "Applied even when the answer is comfortable",
        "Terraform failed it and OpenTofu replaced it",
        "Skipping it is the characteristic drift, named in ADR-0052"
      ]
    },
    {
      "dot": "emerald",
      "title": "An unpinned install is recorded, not invented",
      "items": [
        "Writing a version nobody argued for is a decision nobody made",
        "Four cargo binaries are unpinned today and the registry says so",
        "One of them sets the compiler floor for the whole estate"
      ]
    }
