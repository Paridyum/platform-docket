{
  "extraKnownMarketplaces": {
    "paridyum": {
      "source": {
        "source": "github",
        "repo": "Paridyum/knowledge"
      }
    }
  },
  "enabledPlugins": {
    "paridyum-platform@paridyum": true
  },
